# PolicyPilot Environment Configuration Template
# Copy this file to .env and fill in your keys.

# LLM Providers Configuration
GROQ_API_KEY=your_groq_api_key_here

# Provider Preference: "groq", "openai", "gemini", or "auto"
LLM_PROVIDER=groq

# Optional alternative API keys:
OPENAI_API_KEY=
GEMINI_API_KEY=

# Embedding Provider: "auto", "openai", or "local"
EMBEDDING_PROVIDER=auto
EMBEDDING_DIMENSION=384

# Database Configuration (PostgreSQL with pgvector, falls back to SQLite)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=policypilot

# RAG & Chunking Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RRF_K=60
